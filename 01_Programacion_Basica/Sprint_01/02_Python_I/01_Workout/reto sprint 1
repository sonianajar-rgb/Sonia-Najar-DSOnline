
def normalizar_email(texto):
    # Elimina todos los espacios y convierte a minúsculas
    return "".join(texto.split()).lower()


def parsear_hoja(texto):
    filas = []

    for linea in texto.splitlines():
        if not linea.strip():
            continue

        campos = linea.split(";")

        if len(campos) != 3:
            continue

        nombre, email, programa = campos

        persona = {
            "nombre": nombre.strip(),
            "email": normalizar_email(email),
            "programa": programa.strip()
        }

        filas.append(persona)

    return filas


class Cohorte:
    def __init__(self, codigo, programa):
        self.codigo = codigo
        self.programa = programa
        self.miembros = {}
        self.rechazos = []

    def alta(self, persona):
        email = normalizar_email(persona["email"])

        # Comprobar que la persona pertenece al programa
        if persona["programa"] != self.programa:
            self.rechazos.append({
                "email": email,
                "motivo": "otro_programa"
            })
            return False

        # Comprobar si el correo ya está registrado
        if email in self.miembros:
            self.rechazos.append({
                "email": email,
                "motivo": "duplicado"
            })
            return False

        # Guardar a la persona usando el correo como clave
        persona_limpia = {
            "nombre": persona["nombre"].strip(),
            "email": email,
            "programa": persona["programa"]
        }

        self.miembros[email] = persona_limpia

        return True

    def emails(self):
        return set(self.miembros.keys())

    def total(self):
        return len(self.miembros)

    def __str__(self):
        return (
            f"Cohorte {self.codigo} - "
            f"{self.programa}: {self.total()} miembros"
        )


def inscribir(registro, altas):
    registradas = []
    fuera = []

    # Crear una cohorte por cada programa abierto
    for programa, codigo in COHORTES.items():
        registro[codigo] = Cohorte(codigo, programa)

    # Procesar todas las personas
    for persona in altas:
        programa = persona["programa"]

        # Buscar el código de cohorte de su programa
        if programa not in COHORTES:
            fuera.append(persona)
            continue

        codigo = COHORTES[programa]
        cohorte = registro[codigo]

        if cohorte.alta(persona):
            registradas.append(persona)

    return registradas, fuera


